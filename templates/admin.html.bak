<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>لوحة الإدارة | Menu Smart</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --primary: #d4af37;
            --dark: #111827;
            --dark-2: #1f2937;
            --bg: #f4f6f9;
            --white: #ffffff;
            --text: #1f2937;
            --muted: #6b7280;
            --border: #e5e7eb;
            --green: #16a34a;
            --red: #dc2626;
            --orange: #f59e0b;
            --blue: #2563eb;
            --purple: #7c3aed;
        }

        body {
            font-family: Tahoma, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        button,
        input {
            font-family: inherit;
        }

        a {
            text-decoration: none;
        }

        /* =========================
           TOP BAR
        ========================= */

        .topbar {
            background: linear-gradient(135deg, #111827, #1f2937);
            color: #fff;
            min-height: 74px;
            padding: 0 5%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .12);
        }

        .brand {
            font-size: 23px;
            font-weight: 800;
            letter-spacing: .3px;
        }

        .brand span {
            color: var(--primary);
        }

        .admin-info {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 14px;
        }

        .admin-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(212, 175, 55, .15);
            border: 1px solid rgba(212, 175, 55, .4);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-weight: bold;
        }

        .logout {
            background: var(--red);
            color: #fff;
            padding: 10px 16px;
            border-radius: 9px;
            font-weight: 600;
            transition: .2s;
        }

        .logout:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

        /* =========================
           CONTAINER
        ========================= */

        .container {
            width: min(1250px, 92%);
            margin: 32px auto 50px;
        }

        /* =========================
           WELCOME
        ========================= */

        .welcome {
            background: linear-gradient(135deg, #ffffff, #fafafa);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            margin-bottom: 25px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .05);
        }

        .welcome h1 {
            font-size: 28px;
            margin-bottom: 8px;
            color: var(--dark);
        }

        .welcome p {
            color: var(--muted);
            font-size: 15px;
        }

        /* =========================
           FLASH MESSAGES
        ========================= */

        .flash-container {
            margin-bottom: 20px;
        }

        .flash {
            padding: 14px 18px;
            border-radius: 12px;
            margin-bottom: 10px;
            font-size: 14px;
            font-weight: 600;
        }

        .flash.success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .flash.danger {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

        .flash.warning {
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
        }

        /* =========================
           STATS
        ========================= */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 28px;
        }

        .stat {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 17px;
            padding: 21px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, .05);
            position: relative;
            overflow: hidden;
            transition: .2s;
        }

        .stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, .08);
        }

        .stat::before {
            content: "";
            position: absolute;
            right: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: var(--primary);
        }

        .stat-title {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 800;
            color: var(--dark);
        }

        /* =========================
           SECTIONS
        ========================= */

        .section {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 25px;
            box-shadow: 0 7px 28px rgba(0, 0, 0, .05);
            overflow-x: auto;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-title-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .section-header h2 {
            font-size: 20px;
            color: var(--dark);
        }

        /* =========================
           TABLE
        ========================= */

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            min-width: 1100px;
            overflow: hidden;
        }

        th,
        td {
            padding: 15px 12px;
            text-align: right;
            border-bottom: 1px solid var(--border);
        }

        th {
            background: #f8fafc;
            color: #374151;
            font-size: 13px;
            font-weight: 700;
        }

        td {
            font-size: 13px;
            color: #374151;
        }

        tbody tr {
            transition: .15s;
        }

        tbody tr:hover {
            background: #fafafa;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* =========================
           BADGES
        ========================= */

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .approved,
        .active {
            background: #dcfce7;
            color: #166534;
        }

        .pending {
            background: #fef3c7;
            color: #92400e;
        }

        .rejected,
        .suspended {
            background: #fee2e2;
            color: #991b1b;
        }

        .admin {
            background: #e0e7ff;
            color: #3730a3;
        }

        .restaurant {
            background: #f3f4f6;
            color: #374151;
        }

        /* =========================
           ACTIONS
        ========================= */

        .actions {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .action-form {
            display: inline-block;
            margin: 0;
        }

        .action-btn {
            border: none;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            transition: .18s;
            white-space: nowrap;
        }

        .action-btn:hover {
            transform: translateY(-1px);
            filter: brightness(.94);
        }

        .approve-btn {
            background: var(--green);
        }

        .reject-btn {
            background: var(--red);
        }

        .suspend-btn {
            background: var(--orange);
        }

        .activate-btn {
            background: var(--blue);
        }

        .reset-btn {
            background: var(--purple);
        }

        .no-action {
            color: #9ca3af;
            font-size: 13px;
        }

        /* =========================
           RESET PASSWORD BOX
        ========================= */

        .reset-box {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: #f9fafb;
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .reset-box.show {
            display: block;
        }

        .reset-form {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .reset-input {
            width: 170px;
            padding: 8px 10px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            outline: none;
            font-size: 12px;
            background: #fff;
        }

        .reset-input:focus {
            border-color: var(--purple);
            box-shadow: 0 0 0 2px rgba(124, 58, 237, .1);
        }

        .save-password-btn {
            border: none;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 8px;
            background: var(--purple);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
        }

        .cancel-reset-btn {
            border: none;
            cursor: pointer;
            padding: 8px 12px;
            border-radius: 8px;
            background: #6b7280;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
        }

        .password-note {
            color: var(--muted);
            font-size: 11px;
            margin-top: 7px;
        }

        /* =========================
           EMPTY
        ========================= */

        .empty {
            text-align: center;
            padding: 45px 20px;
            color: #9ca3af;
        }

        .empty-icon {
            font-size: 35px;
            margin-bottom: 10px;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 950px) {

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 650px) {

            .topbar {
                padding: 13px 4%;
                min-height: auto;
            }

            .brand {
                font-size: 19px;
            }

            .admin-info {
                gap: 8px;
            }

            .admin-name span {
                display: none;
            }

            .admin-avatar {
                width: 34px;
                height: 34px;
            }

            .logout {
                padding: 9px 11px;
                font-size: 12px;
            }

            .container {
                width: 94%;
                margin: 20px auto 35px;
            }

            .welcome {
                padding: 22px;
                border-radius: 16px;
            }

            .welcome h1 {
                font-size: 23px;
            }

            .welcome p {
                font-size: 13px;
                line-height: 1.7;
            }

            .stats {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .stat {
                padding: 18px;
            }

            .stat-value {
                font-size: 28px;
            }

            .section {
                padding: 16px;
                border-radius: 16px;
            }

            .section-header h2 {
                font-size: 18px;
            }

            .section-title-icon {
                width: 34px;
                height: 34px;
            }

            table {
                min-width: 1050px;
            }

            .actions {
                flex-direction: column;
                align-items: stretch;
            }

            .action-form {
                width: 100%;
            }

            .action-btn {
                width: 100%;
            }

            .reset-form {
                flex-direction: column;
                align-items: stretch;
            }

            .reset-input,
            .save-password-btn,
            .cancel-reset-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         TOP BAR
    ========================== -->

    <header class="topbar">

        <div class="brand">
            Menu <span>Smart</span>
        </div>

        <div class="admin-info">

            <div class="admin-name">

                <div class="admin-avatar">
                    م
                </div>

                <span>
                    مرحبًا،
                    {{ user["name"] if user else "المدير" }}
                </span>

            </div>

            <a
                href="{{ url_for('logout') }}"
                class="logout"
            >
                تسجيل الخروج
            </a>

        </div>

    </header>


    <main class="container">

        <!-- =========================
             FLASH MESSAGES
        ========================== -->

        {% with messages = get_flashed_messages(with_categories=true) %}

            {% if messages %}

                <div class="flash-container">

                    {% for category, message in messages %}

                        <div class="flash {{ category }}">
                            {{ message }}
                        </div>

                    {% endfor %}

                </div>

            {% endif %}

        {% endwith %}


        <!-- =========================
             WELCOME
        ========================== -->

        <section class="welcome">

            <h1>
                لوحة الإدارة 👋
            </h1>

            <p>
                إدارة المستخدمين والمطاعم ومتابعة حالة النظام من مكان واحد.
            </p>

        </section>


        <!-- =========================
             STATISTICS
        ========================== -->

        <section class="stats">

            <div class="stat">

                <div class="stat-title">
                    إجمالي المستخدمين
                </div>

                <div class="stat-value">
                    {{ users|length }}
                </div>

            </div>


            <div class="stat">

                <div class="stat-title">
                    إجمالي المطاعم
                </div>

                <div class="stat-value">
                    {{ restaurants|length }}
                </div>

            </div>


            <div class="stat">

                <div class="stat-title">
                    حسابات قيد المراجعة
                </div>

                <div class="stat-value">

                    {{
                        users
                        |selectattr("account_status", "equalto", "pending")
                        |list
                        |length
                    }}

                </div>

            </div>


            <div class="stat">

                <div class="stat-title">
                    المدراء
                </div>

                <div class="stat-value">

                    {{
                        users
                        |selectattr("role", "equalto", "admin")
                        |list
                        |length
                    }}

                </div>

            </div>

        </section>


        <!-- =========================
             USERS
        ========================== -->

        <section class="section">

            <div class="section-header">

                <div class="section-title">

                    <div class="section-title-icon">
                        👥
                    </div>

                    <h2>
                        المستخدمون
                    </h2>

                </div>

            </div>


            {% if users %}

            <table>

                <thead>

                    <tr>

                        <th>الاسم</th>
                        <th>البريد</th>
                        <th>الهاتف</th>
                        <th>الصلاحية</th>
                        <th>الحالة</th>
                        <th>تاريخ التسجيل</th>
                        <th>الإجراءات</th>

                    </tr>

                </thead>

                <tbody>

                    {% for item in users %}

                    {% set status = item["account_status"] or "unknown" %}

                    <tr>

                        <td>
                            <strong>
                                {{ item["name"] }}
                            </strong>
                        </td>

                        <td>
                            {{ item["email"] }}
                        </td>

                        <td>
                            {{ item["phone"] or "—" }}
                        </td>

                        <td>

                            {% if item["role"] == "admin" %}

                                <span class="badge admin">
                                    👑 مدير
                                </span>

                            {% else %}

                                <span class="badge restaurant">
                                    صاحب نشاط تجاري
                                </span>

                            {% endif %}

                        </td>

                        <td>

                            {% if status == "approved" or status == "active" %}

                                <span class="badge active">
                                    ● نشط
                                </span>

                            {% elif status == "pending" %}

                                <span class="badge pending">
                                    ● قيد المراجعة
                                </span>

                            {% elif status == "rejected" %}

                                <span class="badge rejected">
                                    ● مرفوض
                                </span>

                            {% elif status == "suspended" %}

                                <span class="badge suspended">
                                    ● موقوف
                                </span>

                            {% else %}

                                <span class="badge">
                                    {{ status }}
                                </span>

                            {% endif %}

                        </td>

                        <td>
                            {{ item["created_at"] or "—" }}
                        </td>

                        <td>

                            {% if item["role"] == "admin" %}

                                <span class="no-action">
                                    —
                                </span>

                            {% else %}

                                <div class="actions">

                                    {% if status == "pending" %}

                                        <form
                                            method="POST"
                                            class="action-form"
                                            action="{{ url_for('approve_user', user_id=item['id']) }}"
                                            onsubmit="return confirm('هل تريد الموافقة على هذا الحساب؟');"
                                        >

                                            <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                                type="submit"
                                                class="action-btn approve-btn"
                                            >
                                                ✓ موافقة
                                            </button>

                                        </form>


                                        <form
                                            method="POST"
                                            class="action-form"
                                            action="{{ url_for('reject_user', user_id=item['id']) }}"
                                            onsubmit="return confirm('هل تريد رفض هذا الحساب؟');"
                                        >

                                            <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                                type="submit"
                                                class="action-btn reject-btn"
                                            >
                                                ✕ رفض
                                            </button>

                                        </form>

                                    {% elif status == "approved" or status == "active" %}

                                        <form
                                            method="POST"
                                            class="action-form"
                                            action="{{ url_for('suspend_user', user_id=item['id']) }}"
                                            onsubmit="return confirm('هل تريد إيقاف هذا الحساب؟');"
                                        >

                                            <button
                                                type="submit"
                                                class="action-btn suspend-btn"
                                            >
                                                ⛔ إيقاف
                                            </button>

                                    {% elif status == "suspended" or status == "rejected" %}

                                        <form
                                            method="POST"
                                            class="action-form"
                                            action="{{ url_for('activate_user', user_id=item['id']) }}"
                                            onsubmit="return confirm('هل تريد إعادة تفعيل هذا الحساب؟');"
                                        >

                                            <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                                type="submit"
                                                class="action-btn activate-btn"
                                            >
                                                ↻ إعادة تفعيل
                                            </button>

                                        </form>

                                    {% endif %}


                                    <!-- زر تغيير كلمة المرور -->

                                    <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                        type="button"
                                        class="action-btn reset-btn"
                                        onclick="toggleResetBox({{ item['id'] }})"
                                    >
                                        🔑 تغيير كلمة المرور
                                    </button>

                                </div>


                                <!-- نموذج تغيير كلمة المرور -->

                                <div
                                    id="reset-box-{{ item['id'] }}"
                                    class="reset-box"
                                >

                                    <form
                                        method="POST"
                                        class="reset-form"
                                        action="{{ url_for('admin_reset_password', user_id=item['id']) }}"
                                        onsubmit="return confirm('هل أنت متأكد من تغيير كلمة مرور هذا المستخدم؟');"
                                    >

                                        <input
                                            type="password"
                                            name="new_password"
                                            class="reset-input"
                                            placeholder="كلمة المرور الجديدة"
                                            minlength="6"
                                            required
                                        >

                                        <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                            type="submit"
                                            class="save-password-btn"
                                        >
                                            حفظ كلمة المرور
                                        </button>

                                        <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn"
                                            type="button"
                                            class="cancel-reset-btn"
                                            onclick="toggleResetBox({{ item['id'] }})"
                                        >
                                            إلغاء
                                        </button>

                                    </form>

                                    <div class="password-note">
                                        كلمة المرور يجب أن تكون 6 أحرف أو أكثر.
                                    </div>

                                </div>

                            {% endif %}

                        </td>

                    </tr>

                    {% endfor %}

                </tbody>

            </table>

            {% else %}

            <div class="empty">

                <div class="empty-icon">
                    👥
                </div>

                لا يوجد مستخدمون حتى الآن.

            </div>

            {% endif %}

        </section>


        <!-- =========================
             RESTAURANTS
        ========================== -->

        <section class="section">

            <div class="section-header">

                <div class="section-title">

                    <div class="section-title-icon">
                        🍽
                    </div>

                    <h2>
                        المطاعم
                    </h2>

                </div>

            </div>


            {% if restaurants %}

            <div class="restaurants-grid">

                {% for restaurant in restaurants %}

                <div class="restaurant-card">

                    <div class="restaurant-card-header">

                        <div class="restaurant-card-icon">
                            🍽️
                        </div>

                        <div class="restaurant-card-title">

                            <h3>
                                {{ restaurant["name"] }}
                            </h3>

                            {% if restaurant["is_active"] %}

                                <span class="badge active">
                                    ● نشط
                                </span>

                            {% else %}

                                <span class="badge suspended">
                                    ● غير نشط
                                </span>

                            {% endif %}

                        </div>

                    </div>

                    <div class="restaurant-card-info">

                        <div>
                            <span>👤 صاحب النشاط</span>
                            <strong>
                                {{ restaurant["owner_name"] or "—" }}
                            </strong>
                        </div>

                        <div>
                            <span>📞 الهاتف</span>
                            <strong>
                                {{ restaurant["phone"] or "—" }}
                            </strong>
                        </div>

                    </div>

                    <div class="restaurant-card-stats">

                        <div>
                            <strong>
                                {{ restaurant["employee_count"] or 0 }}
                            </strong>
                            <span>👥 الموظفون</span>
                        </div>

                        <div>
                            <strong>
                                {{ restaurant["product_count"] or 0 }}
                            </strong>
                            <span>🍽 المنتجات</span>
                        </div>

                        <div>
                            <strong>
                                {{ restaurant["order_count"] or 0 }}
                            </strong>
                            <span>📦 الطلبات</span>
                        </div>

                    </div>

                    <div class="restaurant-card-footer">

                        <a
                            href="/menu/{{ restaurant['slug'] }}"
                            target="_blank"
                            class="restaurant-menu-link"
                        >
                        <a href="/admin/restaurant/{{ restaurant["id"] }}" class="restaurant-profile-btn">
                            ملف النشاط
                        </a>

                    </div>

                </div>

                {% endfor %}

            </div>

            {% else %}

            <div class="empty">

                <div class="empty-icon">
                    🍽
                </div>

                لا توجد مطاعم حتى الآن.

            </div>

            {% endif %}

        </section>

    </main>


    <script>

        function toggleResetBox(userId) {

            const box = document.getElementById(
                "reset-box-" + userId
            );

            if (!box) {
                return;
            }

            box.classList.toggle("show");
        }

    </script>

</body>

</html>